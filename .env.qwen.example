# Copy this file to .env.qwen and replace the API key before starting vLLM.
QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct
QWEN_BIND_IP=127.0.0.1
QWEN_PORT=8001
QWEN_API_KEY=change-me-qwen-key
QWEN_DTYPE=half
QWEN_MAX_MODEL_LEN=4096
QWEN_GPU_MEMORY_UTILIZATION=0.35
QWEN_MAX_NUM_SEQS=2
QWEN_ENFORCE_EAGER=true
HF_HOME=__PROJECT_DIR__/model-cache/huggingface
