APP_NAME="Enterprise Knowledge RAG Agent"
APP_BIND_IP=127.0.0.1
APP_PORT=8000
APP_API_KEY=change-me-app-key

DATA_DIR=__PROJECT_DIR__/data-server
DATABASE_PATH=__PROJECT_DIR__/data-server/rag.db
MAX_UPLOAD_MB=50
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
EVIDENCE_MIN_COVERAGE=0.20
EVIDENCE_MIN_ANCHOR_COVERAGE=0.20

RETRIEVAL_BACKEND=qdrant
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
HF_HOME=__PROJECT_DIR__/model-cache/huggingface

# Embedded persistent Qdrant: single process, no separate server or Docker needed.
QDRANT_URL=local:__PROJECT_DIR__/data-server/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANK_CANDIDATES=20

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
