APP_NAME="Enterprise Knowledge RAG Agent"
DATA_DIR=./data
DATABASE_PATH=./data/rag.db
MAX_UPLOAD_MB=30
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
EVIDENCE_MIN_COVERAGE=0.20
EVIDENCE_MIN_ANCHOR_COVERAGE=0.20
RETRIEVAL_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=20
APP_API_KEY=

# Optional OpenAI-compatible chat-completions endpoint.
# Leave these empty to use the built-in extractive answer generator.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
