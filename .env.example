APP_NAME="Enterprise Knowledge RAG Agent"
APP_ENV=development
AUTH_MODE=legacy
# Legacy mode is only for local demos. Set APP_API_KEY to protect a shared demo.
APP_API_KEY=

# Production uses AUTH_MODE=oidc and validates JWTs against this trusted provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_TENANT_CLAIM=tenant_id
OIDC_DEPARTMENTS_CLAIM=departments
OIDC_ROLES_CLAIM=roles
DATA_DIR=./data
DATABASE_PATH=./data/rag.db
DATABASE_URL=
DATABASE_POOL_SIZE=10
UPLOAD_DIR=./data/uploads
TASK_QUEUE_BACKEND=sync
REDIS_URL=
CELERY_QUEUE=ingestion
CELERY_MAX_RETRIES=3
CELERY_SOFT_TIME_LIMIT=840
CELERY_TIME_LIMIT=900
LOG_LEVEL=INFO
JSON_LOGS=false
METRICS_BEARER_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-rag-api
OTEL_EXPORTER_OTLP_ENDPOINT=
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_READ=300
RATE_LIMIT_FEEDBACK=30
AUDIT_HMAC_KEY=
MAX_UPLOAD_MB=30
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
EVIDENCE_MIN_COVERAGE=0.20
EVIDENCE_MIN_ANCHOR_COVERAGE=0.20
RETRIEVAL_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=20
# Optional OpenAI-compatible chat-completions endpoint.
# Leave these empty to use the built-in extractive answer generator.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=2
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
LLM_REQUIRED=false
