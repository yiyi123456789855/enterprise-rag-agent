# Copy this file to .env.server with: bash deploy/init_env.sh
APP_NAME="Enterprise Knowledge RAG Agent"
APP_ENV=production
APP_BIND_IP=127.0.0.1
APP_PORT=8000
AUTH_MODE=oidc
APP_API_KEY=
OIDC_ISSUER=https://login.example.com/realms/enterprise
OIDC_AUDIENCE=enterprise-rag-api
OIDC_JWKS_URL=https://login.example.com/realms/enterprise/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
OIDC_TENANT_CLAIM=tenant_id
OIDC_DEPARTMENTS_CLAIM=departments
OIDC_ROLES_CLAIM=roles

DATA_DIR=/app/data
DATABASE_PATH=/app/data/rag.db
DATABASE_URL=postgresql://rag:change-me-postgres-password@postgres:5432/rag
DATABASE_POOL_SIZE=10
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-postgres-password
UPLOAD_DIR=/app/data/uploads
TASK_QUEUE_BACKEND=celery
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@valkey:6379/0
CELERY_QUEUE=ingestion
CELERY_MAX_RETRIES=3
CELERY_SOFT_TIME_LIMIT=840
CELERY_TIME_LIMIT=900
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_BEARER_TOKEN=change-me-metrics-token
PROMETHEUS_LOCAL_PORT=9090
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-rag-api
# When enabled, use a complete OTLP/HTTP traces endpoint such as http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_READ=300
RATE_LIMIT_FEEDBACK=30
AUDIT_HMAC_KEY=change-me-audit-hmac-key
MAX_UPLOAD_MB=50
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
EVIDENCE_MIN_COVERAGE=0.20
EVIDENCE_MIN_ANCHOR_COVERAGE=0.20

RETRIEVAL_BACKEND=qdrant
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
HF_HOME=/models/huggingface

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-qdrant-key
QDRANT_COLLECTION=enterprise_knowledge
QDRANT_LOCAL_PORT=6333
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=20

# Optional OpenAI-compatible Qwen service. Empty values use extractive answers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=2
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
LLM_REQUIRED=false
